#!/usr/bin/env bash
# gitmirror — переносит активность из приватных репозиториев в репозиторий-зеркало
# на GitHub в виде пустых коммитов. Точка входа.
set -euo pipefail

PROG="$(basename "$0")"

usage() {
  cat <<USAGE
$PROG — синхронизация активности приватных репозиториев в GitHub

Команды:
  init <каталог>   создать зеркало
  add <путь>       добавить репозиторий-источник
  sync             перенести новые коммиты в зеркало
USAGE
}

[ $# -eq 0 ] && { usage; exit 1; }
cmd="$1"; shift
case "$cmd" in
  init|add|sync) echo "ещё не реализовано: $cmd"; exit 1 ;;
  *) echo "неизвестная команда: $cmd" >&2; exit 1 ;;
esac

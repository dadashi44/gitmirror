#!/usr/bin/env bash
# gitmirror — переносит активность из приватных репозиториев в
# репозиторий-зеркало на GitHub в виде пустых коммитов: без кода, без
# оригинальных сообщений. Точка входа: разбор аргументов и маршрутизация.
set -euo pipefail

PROG="$(basename "$0")"

# корень проекта, с учётом запуска через симлинк
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"
LIB="$ROOT/lib"

. "$LIB/core.sh"
. "$LIB/style.sh"
. "$LIB/ui.sh"
. "$LIB/config.sh"
. "$LIB/git.sh"
for f in "$LIB"/commands/*.sh; do . "$f"; done

args=(); while [ $# -gt 0 ]; do
  case "$1" in
    --mirror) MIRROR="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --version) echo "$PROG $VERSION"; exit 0 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- ${args[@]+"${args[@]}"}
[ $# -eq 0 ] && { usage; exit 1; }

cmd="$1"; shift
case "$cmd" in
  setup|init|add|sync|status|sources) "cmd_$cmd" "$@" ;;
  *) die "неизвестная команда: $cmd (см. $PROG --help)" ;;
esac
